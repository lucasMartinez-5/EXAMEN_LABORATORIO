<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/TXVTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/appTitle"
        android:textSize="@dimen/textSizeTitle"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTopFirst"
        />
    <GridLayout
        android:id="@+id/GRLTablero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/TXVTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTop"
        android:columnCount="4"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        >
        <Button
            android:id="@+id/BTN00"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="1"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN01"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="2"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN02"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="3"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN03"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="4"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN10"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="5"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN11"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="6"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN12"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="7"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN13"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="8"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN20"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="9"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN21"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="10"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN22"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="11"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN23"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="12"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN30"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="13"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN31"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="14"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN32"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:text="15"
            android:layout_margin="@dimen/buttonMargin"/>
        <Button
            android:id="@+id/BTN33"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"/>
    </GridLayout>
    <TextView
        android:id="@+id/TXVMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/GRLTablero"
        android:text="@string/Mensaje"
        android:textSize="@dimen/textSizeNormal"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTop"
        android:textColor="@color/purple_700"
        />
    <Button
        android:id="@+id/BTNRestart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/TXVMessage"
        android:text="@string/Restart"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTop"
        android:textSize="@dimen/textSizeNormal"
        android:visibility="visible"/>
    <Button
        android:id="@+id/BTNDisorder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/BTNRestart"
        android:text="@string/Disorder"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTop"
        android:textSize="@dimen/textSizeNormal"
        android:visibility="visible"/>
    <Button
        android:id="@+id/BTNVerify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/BTNDisorder"
        android:text="@string/Verify"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTop"
        android:textSize="@dimen/textSizeNormal"
        android:visibility="visible"/>
</RelativeLayout>